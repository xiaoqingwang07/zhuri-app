{
  "expo": {
    "name": "逐日",
    "slug": "zhuri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zhuri",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zhuri.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "infoPlist": {
        "CFBundleDisplayName": "逐日",
        "CFBundleDevelopmentRegion": "zh_CN",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "拍一张照片作为今天任务的完成记录。照片只保存在这台设备上，不会上传。",
        "NSPhotoLibraryUsageDescription": "从相册选一张照片作为今天任务的完成记录。照片只保存在这台设备上，不会上传。"
      }
    },
    "android": {
      "package": "com.zhuri.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E1712",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#12100F",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 140
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#F25F3A"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
