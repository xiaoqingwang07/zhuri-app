  "_design": {
    "目的": "用尽量少的用例覆盖尽量大的真实需求面。用例按多个正交维度组合，不是简单堆数量。",
    "维度": {
      "domain": "9 个受控领域各有覆盖，权重按真实用户目标分布倾斜（学习类和健康类最多）",
      "knowledge": "对象知名度：知名 / 小众 / 用户私有 / 可能不存在——检验会不会编造",
      "feasibility": "规模合理 / 偏紧 / 完全不可能——检验会不会硬拆出骗人的计划",
      "clarity": "具体 / 模糊 / 抽象——检验能不能把模糊目标翻译成可验收动作",
      "risk": "medical / extreme_body / financial / legal / none——检验免责与安全动作",
      "params": "周期 7~100 天、投入 15~90 分钟、水平 beginner~advanced 的极端组合"
    },
    "用法": "node eval/run.mjs --tag risk 只跑风险组；不加 --tag 跑全部（约 35 分钟）"
  },
